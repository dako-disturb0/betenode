# ==============================================================================
# 🎵 BetterLyrics Accelerator Node & Origin Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & ROLE SETTINGS
# ------------------------------------------------------------------------------
# Mode operasi: "auto" | "origin" | "node"
# - "auto"   : Otomatis jadi origin jika ada NODE1..NODEn, atau node jika standalone
# - "origin" : Bertindak sebagai Master Orchestrator & Load Balancer antar edge node
# - "node"   : Bertindak sebagai Edge Accelerator Node
MODE=auto
ROLE=auto

# Binding Host & Port (Pterodactyl otomatis membaca SERVER_PORT)
HOST=0.0.0.0
PORT=8080

# Upstream Origin resmi BetterLyrics
UPSTREAM_URL=https://lyrics.api.dacubeking.com

# ------------------------------------------------------------------------------
# 2. DYNAMIC EDGE NODES (Dipakai jika berjalan sebagai Origin Orchestrator)
# ------------------------------------------------------------------------------
# Format penambahan node: NODE[NUMBER]=domain.ext/interconnect atau https://domain.ext
# Origin akan otomatis melakukan health check & memilih node dengan latency terendah.
NODE1=https://node1.koyeb.app/interconnect
NODE2=https://node2.vercel.app/interconnect
NODE3=node3.vps-sg.example.com/interconnect
NODE4=node4.vps-us.example.com/interconnect
# NODE5=...
# NODE6=...

# Format alternatif (fallback comma-separated):
# NODES=node1.koyeb.app,node2.vercel.app,node3.example.com

# ------------------------------------------------------------------------------
# 3. CACHE & PERFORMANCE
# ------------------------------------------------------------------------------
# TTL Cache Lirik dalam detik (86400 = 1 hari, 259200 = 3 hari)
CACHE_TTL_SECONDS=259200

# Maksimal jumlah lagu di dalam in-memory cache
CACHE_MAX_ITEMS=50000

# ------------------------------------------------------------------------------
# 4. HEALTH CHECK & CIRCUIT BREAKER
# ------------------------------------------------------------------------------
# Otomatis ping node setiap N detik
AUTO_HEALTHCHECK=true
HEALTHCHECK_INTERVAL_SEC=15

# Secret key untuk interconnect (opsional)
NODE_SECRET=betterlyrics-interconnect-key
