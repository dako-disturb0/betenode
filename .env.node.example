# ==============================================================================
# 🚀 BetterLyrics Edge Node Environment Variables
# Gunakan konfigurasi ini untuk deployment Node (Vercel, Koyeb, VPS, Pterodactyl)
# ==============================================================================

# Mode Operasi (Wajib di-set sebagai 'node')
MODE=node
ROLE=node

# Upstream Official BetterLyrics API
UPSTREAM_URL=https://lyrics.api.dacubeking.com

# Port listener (untuk VPS / Pterodactyl / Docker; diabaikan di Vercel/Netlify)
PORT=8080
HOST=0.0.0.0

# Pengaturan Cache Memory di Edge Node
# TTL Cache Lirik dalam detik (259200 detik = 3 hari)
CACHE_TTL_SECONDS=259200
# Jumlah maksimum lirik lagu yang disimpan di memori
CACHE_MAX_ITEMS=50000

# Secret token untuk proteksi endpoint /interconnect (Opsional)
NODE_SECRET=betterlyrics-interconnect-key
